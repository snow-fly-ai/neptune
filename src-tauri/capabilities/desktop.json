{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only plugins used by the bridge",
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "autostart:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula",
  "version": "0.5.0",
  "identifier": "com.snowfly.nebula",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebula",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#04070B",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "snowfly",
    "shortDescription": "Message the coding agents on your PC from your phone",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QTQ0NkM0NDA1NzNBNTMKUldSVE9sZEF4RWFrdGlpdTQvTUdYV280eHNLTEQ5cmlhQi90WDJuMnVYL1A1Um0xSTJoOTFnL0oK",
      "endpoints": [
        "https://github.com/snow-fly-ai/nebula/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
